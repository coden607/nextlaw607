{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextlaw607",
  "main": "apps/web/worker.mjs",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "apps/web/public-dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/status/*"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
