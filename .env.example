# Optional Supabase Auth. Leave both unset for local guest/reject-by-default identity mode.
# Configure both together to enable bearer-token verification through Supabase Auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only entitlement repository credential. Never expose this to the PWA/client.
# Configure with SUPABASE_URL on the API/deployment runtime only.
SUPABASE_SECRET_KEY=

# Optional server-side observability. The application must sanitize telemetry before
# any sink sees it. Leave these unset for local/no-export mode.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
SENTRY_DSN=

# Standard OpenTelemetry exporter configuration may be supplied by the server runtime.
# Do not enable payload capture of prompts, case-private content, or authority text.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Never place sb_secret_*, Langfuse secret keys, Sentry DSNs, or service-role
# credentials in client-accessible configuration.
