# NextLaw607 production environment inventory
# Names only. Never commit values.
# Format: KIND NAME [DEFAULT]
# KIND=secret -> GitHub Actions repository secret
# KIND=variable -> GitHub Actions repository variable
# KIND=cloudflare-secret -> Cloudflare Worker secret (also stored as GitHub secret when required by deployment workflow)

secret SUPABASE_URL
secret SUPABASE_PUBLISHABLE_KEY
secret SUPABASE_SECRET_KEY
secret MEM0_API_KEY
secret LANGFUSE_PUBLIC_KEY
secret LANGFUSE_SECRET_KEY
secret SENTRY_DSN
secret SENTRY_AUTH_TOKEN
secret SENTRY_ORG
secret SENTRY_PROJECT
secret ANTHROPIC_API_KEY
secret CLOUDFLARE_API_TOKEN
secret CLOUDFLARE_ACCOUNT_ID
secret NEXTLAW_API_ORIGIN
secret CLOUDFLARE_DEPLOY_URL
secret OTEL_EXPORTER_OTLP_ENDPOINT

variable LANGFUSE_BASE_URL https://cloud.langfuse.com
variable SENTRY_BASE_URL https://sentry.io
variable NEXTLAW_EVAL_MODEL claude-sonnet-5
variable RAGAS_DO_NOT_TRACK true

cloudflare-secret NEXTLAW_API_ORIGIN
